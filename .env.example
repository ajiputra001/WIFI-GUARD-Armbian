# ═══════════════════════════════════════════════════════════════
# 🛡️ WiFi Guard Bot — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# Target WhatsApp Phone Number or Group ID (e.g. 6281234567890 or 120363012345678901@g.us)
ALERT_PHONE_NUMBER=

# Network Interface & Subnet (Leave blank to auto-detect interface e.g. end0, eth0, wlan0)
NETWORK_INTERFACE=
NETWORK_SUBNET=

# Network Scanner Settings
SCAN_INTERVAL=3
ALERTS_ENABLED=true
ALERT_ON_DISCONNECT=true

# Deep Scan (nmap OS detection)
DEEP_SCAN_ENABLED=true
DEEP_SCAN_INTERVAL=5

# Daily Report Cron (Everyday at 08:00 AM)
DAILY_REPORT_ENABLED=true
DAILY_REPORT_HOUR=8
DAILY_REPORT_MINUTE=0

# Web Dashboard Port
DASHBOARD_PORT=3000
DASHBOARD_ENABLED=true

# 🔊 AUX Audio Speaker Out (Armbian STB)
VOICE_ALERT_ENABLED=true
VOICE_ALERT_STYLE=stasiun
VOICE_ALERT_LANG=id
VOICE_ALERT_PITCH=92
VOICE_ALERT_SPEED=165
VOICE_ALERT_ON_NEW_DEVICE=true
VOICE_ALERT_ON_RECONNECT=true
VOICE_ALERT_ON_DISCONNECT=true
